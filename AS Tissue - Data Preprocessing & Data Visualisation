# STEP 15 — DRUG EFFECTS: NOMINAL TOP HITS
#
# Exploratory only:
# p < 0.05 and |logFC| > 0.58.
# These results are NOT FDR corrected - J to evaluate signals
 
p3_nin_top <- p3_results_nintedanib %>%
  filter(
    P.Value < 0.05,
    abs(logFC) > 0.58
  ) %>%
  arrange(P.Value) %>%
  slice_head(n = 20) %>%
  mutate(
    Drug = "Nintedanib",
    Protein = rownames(.)
  )


p3_sen_top <- p3_results_senicapoc %>%
  filter(
    P.Value < 0.05,
    abs(logFC) > 0.58
  ) %>%
  arrange(P.Value) %>%
  slice_head(n = 20) %>%
  mutate(
    Drug = "Senicapoc",
    Protein = rownames(.)
  )


p3_drug_df <- bind_rows(
  p3_nin_top,
  p3_sen_top
) %>%
  mutate(
    Direction = ifelse(
      logFC > 0,
      "Up",
      "Down"
    ),

    Protein = factor(
      Protein,
      levels = unique(
        Protein[
          order(
            abs(logFC),
            decreasing = TRUE
          )
        ]
      )
    )
  )


if (nrow(p3_drug_df) > 0) {

  p3_bar <- ggplot(
    p3_drug_df,
    aes(
      x = reorder(Protein, logFC),
      y = logFC,
      fill = Direction
    )
  ) +

    geom_col() +

    geom_hline(
      yintercept = c(-0.58, 0.58),
      linetype = "dashed",
      colour = "grey40",
      linewidth = 0.5
    ) +

    coord_flip() +

    facet_wrap(
      ~ Drug,
      scales = "free_y"
    ) +

    scale_fill_manual(
      values = c(
        "Up" = "#E53935",
        "Down" = "#2196F3"
      )
    ) +

    theme_classic(
      base_size = 11
    ) +

    labs(
      title = "AV — Drug effects: top nominal hits",
      subtitle = paste(
        "p < 0.05, not FDR corrected.",
        "No proteins survive FDR < 0.1."
      ),
      x = NULL,
      y = expression(
        log[2] ~
          "Fold Change vs TGFB1_DMSO"
      ),
      fill = NULL
    ) +

    theme(
      legend.position = "bottom",
      strip.text = element_text(
        face = "bold",
        size = 11
      )
    )


