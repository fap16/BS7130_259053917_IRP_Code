  "\n"
)


if (length(p3_sig_union) >= 2) {

  # Limit to top 100 proteins if necessary
  if (length(p3_sig_union) > 100) {

    p3_min_adjp <- sapply(
      p3_sig_union,
      function(prot) {

        min(
          if (
            prot %in%
            rownames(p3_results_baseline)
          ) {
            p3_results_baseline[
              prot,
              "adj.P.Val"
            ]
          } else {
            1
          },

          if (
            prot %in%
            rownames(p3_results_nintedanib)
          ) {
            p3_results_nintedanib[
              prot,
              "adj.P.Val"
            ]
          } else {
            1
          },

          if (
            prot %in%
            rownames(p3_results_senicapoc)
          ) {
            p3_results_senicapoc[
              prot,
              "adj.P.Val"
            ]
          } else {
            1
          }
        )
      }
    )


    p3_plot_proteins <- names(
      sort(p3_min_adjp)
    )[1:100]

    cat(
      "Showing top 100 most significant proteins\n"
    )

  } else {

    p3_plot_proteins <- p3_sig_union
  }


  # Heatmap matrix
  p3_hm <- p3_expr_final[
    p3_plot_proteins,
    ,
    drop = FALSE
  ]

  p3_hm_z <- pmin(
    pmax(
      t(scale(t(p3_hm))),
      -2
    ),
    2
  )


  # Column ordering
  p3_col_ord <- order(
    p3_samples$Condition
  )


  # Column annotations
  p3_col_ann <- data.frame(
    Condition = p3_samples$Condition[
      p3_col_ord
    ],
    Donor = p3_samples$Donor[
      p3_col_ord
    ],
    row.names = p3_samples$Sample[
      p3_col_ord
    ]
  )


  # Row annotations
  p3_row_ann <- data.frame(
    Baseline = ifelse(
      p3_plot_proteins %in%
        rownames(p3_sig_baseline),
      "Yes",
      "No"
    ),

    Nintedanib = ifelse(
      p3_plot_proteins %in%
        rownames(p3_sig_nintedanib),
      "Yes",
      "No"
    ),

    Senicapoc = ifelse(
      p3_plot_proteins %in%
        rownames(p3_sig_senicapoc),
      "Yes",
      "No"
    ),

    row.names = p3_plot_proteins
  )


  # Donor annotation colours
  p3_donor_colours <- setNames(
    brewer.pal(
      max(
        3,
        length(
          levels(p3_samples$Donor)
        )
      ),
      "Set2"
    ),
    levels(p3_samples$Donor)
  )


  p3_ph <- pheatmap(
    p3_hm_z[
      ,
      p3_col_ord,
      drop = FALSE
    ],

    annotation_col = p3_col_ann,

    annotation_row = p3_row_ann,

    annotation_colors = list(
