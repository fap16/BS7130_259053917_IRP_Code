# STEP 1 — IMPORT & FILTER
#
# NOTE:
# The sample-list sheet is named "SampeList" in the original file


p3_samples_raw <- read_excel(
  "AV_Tissue_SampleandProteinList_CM.xlsx",
  sheet = "SampeList"
)

p3_proteins_raw <- read_excel(
  "AV_Tissue_SampleandProteinList_CM.xlsx",
  sheet = "ProteinList"
)


# Keep the four conditions used in Pipeline 3
p3_samples <- p3_samples_raw %>%
  filter(
    Condition %in% c(
      "SF_DMSO_citric",
      "TGFB1_DMSO",
      "TGFB1_Nintedanib",
      "TGFB1_Senicapoc"
    )
  ) %>%
  mutate(
    Condition = factor(
      Condition,
      levels = c(
        "SF_DMSO_citric",
        "TGFB1_DMSO",
        "TGFB1_Nintedanib",
        "TGFB1_Senicapoc"
      )
    ),
    Donor = factor(Donor)
  )


cat("\n=== P3 STEP 1 COMPLETE ===\n")
cat("Samples retained:", nrow(p3_samples), "\n")
cat("Design balance:\n")
print(table(p3_samples$Condition, p3_samples$Donor))


# Condition colours
p3_colours <- c(
  "SF_DMSO_citric"   = "#2196F3",
  "TGFB1_DMSO"       = "#E53935",
  "TGFB1_Nintedanib" = "#4CAF50",
  "TGFB1_Senicapoc"  = "#FF9800"
)


################################
# STEPS 2–7.5 — EXPRESSION MATRIX, FILTERING, IMPUTATION,
#              NORMALISATION & DENOISING

# STEP 2 — Build expression matrix


p3_sample_names <- p3_samples$Sample

p3_expr <- p3_proteins_raw %>%
  select(all_of(p3_sample_names)) %>%
  mutate(
    across(everything(), ~ as.numeric(as.character(.)))
  ) %>%
  as.data.frame()

rownames(p3_expr) <- make.unique(
  as.character(p3_proteins_raw$PG.Genes)
)

stopifnot(
  all(colnames(p3_expr) == p3_samples$Sample)
)

cat(
  "Expression matrix:",
  nrow(p3_expr),
  "proteins x",
  ncol(p3_expr),
  "samples\n\n"
)


# STEP 3 — Completeness filtering

p3_min_v <- ceiling(0.70 * ncol(p3_expr))

p3_expr_c <- p3_expr[
  apply(
    p3_expr,
    1,
    function(x) sum(!is.na(x) & x > 0)
  ) >= p3_min_v,
]

cat(
  "After completeness filtering:",
  nrow(p3_expr_c),
  "proteins\n"
)

# STEP 4 — Imputation & log2 transformation 

p3_expr_i <- p3_expr_c

# Treat zero values as missing
p3_expr_i[p3_expr_i == 0] <- NA

# Column-wise minimum-based imputation
for (j in seq_len(ncol(p3_expr_i))) {

  p3_min_value <- min(
    p3_expr_i[, j],
    na.rm = TRUE
  )

  if (!is.finite(p3_min_value)) {
    p3_min_value <- 1
  }

  p3_expr_i[
    is.na(p3_expr_i[, j]),
    j
  ] <- p3_min_value / 5
}

# Log2 transform
p3_expr_l <- log2(as.matrix(p3_expr_i))
 
# STEP 5 — Median centring 

p3_global_median <- median(p3_expr_l)

p3_sample_medians <- apply(
  p3_expr_l,
  2,
  median
)

p3_expr_n <- sweep(
  p3_expr_l,
  2,
  p3_global_median - p3_sample_medians,
  "+"
)

 
# STEP 6 — Abundance and variability filtering 

# Abundance filter
p3_expr_a <- p3_expr_n[
  rowMeans(p3_expr_n) >
    quantile(rowMeans(p3_expr_n), 0.40),
]

# MAD variability filter
p3_mv <- rowMads(p3_expr_a)

p3_expr_v <- p3_expr_a[
  p3_mv > median(p3_mv),
]


# Remove near-zero-variance features
p3_nzv <- nearZeroVar(t(p3_expr_v))

if (length(p3_nzv) > 0) {
  p3_expr_v <- p3_expr_v[-p3_nzv, , drop = FALSE]
}

cat(
  "After abundance/variability filtering:",
  nrow(p3_expr_v),
  "proteins\n"
)
 
# STEP 7.5 — ARSyNseq donor-effect denoising 

p3_factors <- data.frame(
  Condition = p3_samples$Condition,
  Donor     = p3_samples$Donor,
  row.names = p3_samples$Sample
)

p3_nd <- readData(
  data = as.data.frame(p3_expr_v),
  factors = p3_factors
)

p3_den_obj <- ARSyNseq(
  p3_nd,
  factor = "Donor",
  batch = TRUE,
  norm = "n",
  logtransf = TRUE
)

p3_expr_final <- as.matrix(
  exprs(p3_den_obj)
)

p3_expr_final <- p3_expr_final[
  ,
  p3_samples$Sample,
  drop = FALSE
]


cat("\n=== P3 STEP 7.5 COMPLETE ===\n")
cat(
  "Final matrix:",
  nrow(p3_expr_final),
  "proteins x",
  ncol(p3_expr_final),
  "samples\n\n"
)



################################
## STEP 2 DIFFERENTIALLY EXPRESSION ANALYSIS 


# STEP 8 — LIMMA: SINGLE MODEL, THREE CONTRASTS 

p3_design <- model.matrix(
  ~ 0 + Condition,
  data = p3_samples
)

colnames(p3_design) <- levels(
  p3_samples$Condition
)

p3_fit <- lmFit(
  p3_expr_final,
  p3_design
)


# Define all three contrasts
p3_contrasts <- makeContrasts(
  Baseline   = TGFB1_DMSO - SF_DMSO_citric,
  Nintedanib = TGFB1_Nintedanib - TGFB1_DMSO,
  Senicapoc  = TGFB1_Senicapoc - TGFB1_DMSO,
  levels = p3_design
)


# Fit contrasts
p3_fit2 <- contrasts.fit(
  p3_fit,
  p3_contrasts
)

# Robust empirical Bayes moderation
p3_fit2 <- eBayes(
  p3_fit2,
  trend = TRUE,
  robust = TRUE
)
 
# HELPER FUNCTION 1 — EXTRACT LIMMA RESULTS 

p3_extract <- function(
  fit2,
  coef_name,
  up_label,
  down_label
) {

  res <- topTable(
    fit2,
    coef = coef_name,
    number = Inf,
    sort.by = "P"
  ) %>%
    mutate(
      negLogP = -log10(P.Value),

      Direction = case_when(
        adj.P.Val < 0.1 & logFC > 0.58 ~ up_label,
        adj.P.Val < 0.1 & logFC < -0.58 ~ down_label,
        TRUE ~ "Not significant"
      ),

      Contrast = coef_name
    )


  cat(sprintf(
    "\n=== P3 %s ===\n",
    coef_name
  ))

  cat(
    "Proteins tested:                     ",
    nrow(res),
    "\n"
  )

  cat(
    "Raw p < 0.05:                        ",
    sum(res$P.Value < 0.05),
    "\n"
  )

  cat(
    "FDR adj.P.Val < 0.1:                 ",
    sum(res$adj.P.Val < 0.1),
    "\n"
  )

  cat(
    "FDR < 0.1 & |logFC| > 0.58 [SIG]:   ",
    sum(
      res$adj.P.Val < 0.1 &
        abs(res$logFC) > 0.58
    ),
    "\n"
  )

  cat(
    "  Up:   ",
    sum(res$Direction == up_label),
    "\n"
  )

  cat(
    "  Down: ",
    sum(res$Direction == down_label),
    "\n\n"
  )


  return(res)
}

 
# HELPER FUNCTION 2 — EXPORT RESULTS 

p3_export <- function(
  results,
  contrast_name,
  up_label,
  down_label
) {

  # All proteins
  write.csv(
    results,
    paste0(
      "P3_",
      contrast_name,
      "_all_proteins.csv"
    ),
    row.names = TRUE
  )


  # FDR-significant proteins
  sig <- results %>%
    filter(
      adj.P.Val < 0.1,
      abs(logFC) > 0.58
    ) %>%
    arrange(adj.P.Val) %>%
    select(
      logFC,
      AveExpr,
      t,
      P.Value,
      adj.P.Val,
      negLogP,
      Direction
    )


  write.csv(
    sig,
    paste0(
      "P3_",
      contrast_name,
      "_FDR_significant.csv"
    ),
    row.names = TRUE
  )


  # Top 10 upregulated
  top_up <- results %>%
    filter(
      adj.P.Val < 0.1,
      logFC > 0.58
    ) %>%
    arrange(desc(logFC)) %>%
    slice_head(n = 10) %>%
    mutate(
      FoldChange = round(2^logFC, 3),
      logFC      = round(logFC, 3),
      P.Value    = signif(P.Value, 3),
      adj.P.Val  = signif(adj.P.Val, 3)
    ) %>%
    select(
      logFC,
      FoldChange,
      P.Value,
      adj.P.Val,
      Direction
    )


  # Top 10 downregulated
  top_down <- results %>%
    filter(
      adj.P.Val < 0.1,
      logFC < -0.58
    ) %>%
    arrange(logFC) %>%
    slice_head(n = 10) %>%
    mutate(
      FoldChange = round(2^logFC, 3),
      logFC      = round(logFC, 3),
      P.Value    = signif(P.Value, 3),
      adj.P.Val  = signif(adj.P.Val, 3)
    ) %>%
    select(
      logFC,
      FoldChange,
      P.Value,
      adj.P.Val,
      Direction
    )


  # Combine top up/down proteins
  write.csv(
    bind_rows(top_up, top_down),
    paste0(
      "P3_",
      contrast_name,
      "_top20_FC.csv"
    ),
    row.names = TRUE
  )


  cat(sprintf(
    "Saved: P3_%s | FDR sig: %d | Up: %d | Down: %d\n\n",
    contrast_name,
    nrow(sig),
    sum(sig$Direction == up_label),
    sum(sig$Direction == down_label)
  ))


  return(sig)
}
 
