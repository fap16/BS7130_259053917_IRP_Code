  )

} else {

  cat(
    "No nominal drug hits to plot\n"
  )
}



# STEP 16 — PCA: TOP 500 MOST VARIABLE PROTEINS
#
# Variance is calculated blind to condition labels.

p3_top500 <- order(
  rowVars(
    as.matrix(p3_expr_final)
  ),
  decreasing = TRUE
)[
  1:min(
    500,
    nrow(p3_expr_final)
  )
]


p3_pca_top500 <- prcomp(
  t(
    p3_expr_final[
      p3_top500,
      ,
      drop = FALSE
    ]
  ),
  scale. = TRUE
)


p3_pv_top500 <- round(
  100 *
    p3_pca_top500$sdev^2 /
    sum(
      p3_pca_top500$sdev^2
    ),
  1
)


p3_pca_df_top500 <- data.frame(
  PC1 = p3_pca_top500$x[, 1],
  PC2 = p3_pca_top500$x[, 2],
  Condition = p3_samples$Condition,
  Donor = p3_samples$Donor
)


p3_centroids_top500 <- p3_pca_df_top500 %>%
  group_by(Condition) %>%
  summarise(
    PC1 = mean(PC1),
    PC2 = mean(PC2),
    .groups = "drop"
  )


get_p3_centroid <- function(cond) {

  p3_centroids_top500 %>%
    filter(Condition == cond)
}


# Treatment arrows
p3_arrow_df_top500 <- bind_rows(

  # TGF-B1 effect
  data.frame(
    x = get_p3_centroid(
      "SF_DMSO_citric"
    )$PC1,

    y = get_p3_centroid(
      "SF_DMSO_citric"
    )$PC2,

    xend = get_p3_centroid(
      "TGFB1_DMSO"
    )$PC1,

    yend = get_p3_centroid(
      "TGFB1_DMSO"
    )$PC2
  ),

  # Nintedanib
  data.frame(
    x = get_p3_centroid(
      "TGFB1_DMSO"
    )$PC1,

    y = get_p3_centroid(
      "TGFB1_DMSO"
    )$PC2,

    xend = get_p3_centroid(
      "TGFB1_Nintedanib"
    )$PC1,

    yend = get_p3_centroid(
      "TGFB1_Nintedanib"
    )$PC2
  ),

  # Senicapoc
  data.frame(
    x = get_p3_centroid(
      "TGFB1_DMSO"
    )$PC1,

    y = get_p3_centroid(
      "TGFB1_DMSO"
    )$PC2,

    xend = get_p3_centroid(
      "TGFB1_Senicapoc"
    )$PC1,

    yend = get_p3_centroid(
      "TGFB1_Senicapoc"
    )$PC2
  )
)


p3_pca_top500_plot <- ggplot(
  p3_pca_df_top500,
  aes(
    PC1,
    PC2,
    colour = Condition
  )
) +

  geom_point(
    size = 4,
    alpha = 0.85
  ) +

  stat_ellipse(
    aes(group = Condition),
    type = "norm",
    linetype = "dashed",
    linewidth = 0.5,
    alpha = 0.7
  ) +

  geom_segment(
    data = p3_arrow_df_top500,
    aes(
      x = x,
      y = y,
      xend = xend,
      yend = yend
    ),
    arrow = arrow(
      length = unit(0.18, "cm"),
      type = "closed"
    ),
    colour = "grey50",
    linewidth = 0.4,
    inherit.aes = FALSE
  ) +

  geom_label(
    data = p3_centroids_top500,
    aes(
      PC1,
      PC2,
      label = Condition,
      colour = Condition
    ),
    size = 2.8,
    fontface = "bold",
    show.legend = FALSE,
    fill = "white",
    alpha = 0.7
  ) +

  scale_colour_manual(
    values = p3_colours
  ) +

  theme_classic(
    base_size = 13
  ) +

  labs(
    title = "Aortic Stenosis PCA — Top 500 Most Variable Proteins",
    subtitle = paste(
      "Variance calculated blind to condition labels — exploratory"
    ),
    x = paste0(
      "PC1 (",
      p3_pv_top500[1],
      "%)"
    ),
    y = paste0(
      "PC2 (",
      p3_pv_top500[2],
      "%)"
    )
  )


print(p3_pca_top500_plot)


ggsave(
  "P3/P3_PCA_top500.pdf",
