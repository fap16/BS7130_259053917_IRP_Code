library(clusterProfiler)
library(org.Hs.eg.db)
library(enrichplot)
library(tidyverse)


#ipf 

ipf <- read.csv("P2/P2_Baseline_FDR_significant.csv")

colnames(ipf)

genes <- ipf$PG.Genes

genes <- genes[genes != ""]
genes <- genes[!is.na(genes)]

length(genes)


gene.df <- bitr(
  genes,
  fromType = "SYMBOL",
  toType = "ENTREZID",
  OrgDb = org.Hs.eg.db
)

ego_BP <- enrichGO(
  gene          = gene.df$ENTREZID,
  OrgDb         = org.Hs.eg.db,
  ont           = "BP",
  pAdjustMethod = "BH",
  pvalueCutoff  = 0.05,
  qvalueCutoff  = 0.05,
  readable      = TRUE
)

write.csv(
  as.data.frame(ego_BP),
  "IPF_GO_BP.csv",
  row.names = FALSE
)
dotplot(
  ego_BP,
  title("IPF - Gene Ontology: Enriched Pathways"), 
  showCategory = 20
)

