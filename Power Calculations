# STEP 8: ESTIMATE PROTEINS DETECTABLE WITH LARGER SAMPLE SIZES
#
# This final section asks a different question:
#
# "If the study had more donors, approximately how many proteins might become
# detectable?"
#
# The function compares:
#
#   1. Proteins currently significant at FDR < 0.10
#   2. Proteins with nominal p < 0.05
#   3. A rough estimate of proteins that may become detectable with a larger n
#
# IMPORTANT:
# This is an approximate exploratory estimate rather than a formal prospective
# power calculation. It is intended to illustrate the potential benefit of
# increasing sample size.


estimate_proteins <- function(results_df, label, target_n, current_n) {
  
  
   # Count proteins currently significant using the study's FDR/logFC criteria.
   
  current_sig <- sum(results_df$adj.P.Val < 0.1 & abs(results_df$logFC) > 0.58)
  
  
  # Approximate how much statistical power increases with sample size.
  #
  # The approximation assumes that power scales with sqrt(n).
   
  power_ratio <- sqrt(target_n / current_n)
  
  
  # Count proteins that are nominally significant.
    # These may represent effects that could potentially become significant
  # after increasing sample size.
 
nominal_sig <- sum(results_df$P.Value < 0.05 & abs(results_df$logFC) > 0.58)
  
  
   # Create a rough estimate of how many proteins might become detectable
  # at the larger target sample size.
  
  adjusted_alpha <- 0.05 * power_ratio
  
  estimated_sig <- sum(results_df$P.Value < adjusted_alpha &
                         abs(results_df$logFC) > 0.58)
  
  # Print the results for this comparison.
  
  cat(sprintf("\n%s:\n", label))
  
  cat("  Current n:", current_n, "\n")
  cat("  Target n:", target_n, "\n")
  
  cat("  Currently FDR<0.1 significant:", current_sig, "\n")
  
  cat("  Nominally significant (p<0.05):", nominal_sig, "\n")
  
  cat("  Estimated detectable at target n:", estimated_sig, "\n")
  
  
  # Return the estimated number of detectable proteins.
  return(estimated_sig)
}

#########################################################################
# AIM 1 — ESTIMATED EFFECT OF INCREASING SAMPLE SIZE
#
# IPF: target n = 40
# AS:  target n = 270
#
# These values correspond to the approximate sample sizes identified above
# for detecting the observed effects at the stricter FDR threshold.

estimate_proteins(
  results_baseline,
  "IPF Baseline",
  target_n=40,
  current_n=3
)

estimate_proteins(
  p3_results_baseline,
  "AS Baseline",
  target_n=270,
  current_n=5
)


