# STEP 8 — DRUG TARGET NETWORK — ALL TRIPLE-VALIDATED DRUGS 

# Build a drug-target network using candidates supported by all three analyses.
# Target relationships are taken from the IPF NeDRex drug-target file.

all_triple_drugs <- triple_validated$Drug

network_df_triple <- nedrex_ipf %>%
  dplyr::filter(drug_name %in% all_triple_drugs)

cat("\nDrug-target pairs for triple-validated drugs:",
    nrow(network_df_triple), "\n")

cat("Unique drugs in IPF network:",
    length(unique(network_df_triple$drug_name)), "\n")


# Check whether any triple-validated drugs are missing from the IPF
# drug-target interaction file.
missing_from_ipf <- all_triple_drugs[
  !all_triple_drugs %in% nedrex_ipf$drug_name]

cat("Triple-validated drugs not in IPF target file:",
    length(missing_from_ipf), "\n")

if (length(missing_from_ipf) > 0) print(missing_from_ipf)


# Convert drug-target relationships into network edges.
edges_triple <- network_df_triple %>%
  dplyr::select(drug_name, target_gene) %>%
  dplyr::rename(from = drug_name, to = target_gene)


# Create and classify drug/protein network nodes.
nodes_triple <- data.frame(
  name = unique(c(edges_triple$from, edges_triple$to)),
  stringsAsFactors = FALSE
) %>%
  dplyr::mutate(
    type     = ifelse(name %in% edges_triple$from, "Drug", "Protein"),
    category = dplyr::case_when(
      name %in% edges_triple$from ~ "Drug",
      name %in% shared_genes      ~ "Shared IPF & AS",
      name %in% ipf_sig_genes     ~ "IPF significant",
      TRUE                        ~ "Network protein"
    )
  )

cat("\nNetwork node categories:\n")
print(table(nodes_triple$category))


# Construct the undirected drug-target network.
g_triple <- tbl_graph(
  nodes = nodes_triple,
  edges = edges_triple,
  directed = FALSE
)


# Visualise the network.
# Red = drug
# Purple = shared IPF & AS protein
# Blue = IPF significant protein
# Grey = other network protein

p_network_triple <- ggraph(g_triple, layout = "fr") +
  geom_edge_link(alpha = 0.20, colour = "grey60", linewidth = 0.3) +
  geom_node_point(aes(colour = category, size = type)) +
  geom_node_label(
    aes(label = name, colour = category),
    size         = 2.2,
    repel        = TRUE,
    show.legend  = FALSE,
    max.overlaps = 30
  ) +
  scale_colour_manual(values = c(
    "Drug"            = "#E53935",
    "Shared IPF & AS" = "#9C27B0",
    "IPF significant" = "#2196F3",
    "Network protein" = "grey70"
  )) +
  scale_size_manual(values = c("Drug" = 5, "Protein" = 3)) +
  theme_graph(base_size = 11) +
  labs(
    title    = "Drug-target network — cross-validated fibrotic candidates",
    subtitle = paste0(
      "All triple-validated drugs (IPF + AS + Shared)  |  ",
      "Red = drug  |  Purple = shared IPF & AS protein  |  ",
      "Blue = IPF significant protein"
    ),
    colour = NULL,
    size   = NULL
  ) +
  theme(
    plot.title      = element_text(face = "bold", hjust = 0.5, size = 13),
    plot.subtitle   = element_text(hjust = 0.5, size = 9, colour = "grey40"),
    legend.position = "bottom"
  )

print(p_network_triple)

ggsave("drug_rep/Aim4_drug_target_network_triple.pdf",
       p_network_triple, width = 16, height = 14)

cat("Saved: Aim4_drug_target_network_triple.pdf\n")

 
