# 15. EXPORT RESULTS

export_results <- function(
    results,
    contrast_name,
    up_label,
    down_label,
    prefix = "P2"
) {

  # Full results
  write.csv(
    results,
    paste0(
      prefix,
      "_",
      contrast_name,
      "_all_proteins.csv"
    ),
    row.names = TRUE
  )


  # FDR-significant proteins
  sig <- results %>%
    filter(
      adj.P.Val < 0.1,
      abs(logFC) > 0.58
    ) %>%
    arrange(adj.P.Val) %>%
    select(
      logFC,
      AveExpr,
      t,
      P.Value,
      adj.P.Val,
      negLogP,
      Direction
    )

  write.csv(
    sig,
    paste0(
      prefix,
      "_",
      contrast_name,
      "_FDR_significant.csv"
    ),
    row.names = TRUE
  )


  # Top 10 upregulated
  top_up <- results %>%
    filter(
      adj.P.Val < 0.1,
      logFC > 0.58
    ) %>%
    arrange(desc(logFC)) %>%
    slice_head(n = 10) %>%
    mutate(
      FoldChange = round(2^logFC, 3),
      logFC = round(logFC, 3),
      P.Value = signif(P.Value, 3),
      adj.P.Val = signif(adj.P.Val, 3)
    ) %>%
    select(
      logFC,
      FoldChange,
      P.Value,
      adj.P.Val,
      Direction
    )


  # Top 10 downregulated
  top_down <- results %>%
    filter(
      adj.P.Val < 0.1,
      logFC < -0.58
    ) %>%
    arrange(logFC) %>%
    slice_head(n = 10) %>%
    mutate(
      FoldChange = round(2^logFC, 3),
      logFC = round(logFC, 3),
      P.Value = signif(P.Value, 3),
      adj.P.Val = signif(adj.P.Val, 3)
    ) %>%
    select(
      logFC,
      FoldChange,
      P.Value,
      adj.P.Val,
      Direction
    )


  top20 <- bind_rows(
    top_up,
    top_down
  )

  write.csv(
    top20,
    paste0(
      prefix,
      "_",
      contrast_name,
      "_top20_FC.csv"
    ),
    row.names = TRUE
  )


  cat(
    "\nSaved:",
    contrast_name,
    "\n"
  )

  cat(
    "  All proteins:",
    nrow(results),
    "\n"
  )

  cat(
    "  FDR significant:",
    nrow(sig),
    "\n"
  )

  cat(
    "  Up:",
    sum(sig$Direction == up_label),
    "\n"
  )

  cat(
    "  Down:",
    sum(sig$Direction == down_label),
    "\n"
  )

  return(sig)
}


