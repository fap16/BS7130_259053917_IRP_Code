make_category_heatmap <- function(
    proteins,
    expr_mat,
    samples_df,
    results_list,
    contrast_names,
    colours,
    title,
    filename
) {

  if (length(proteins) < 2) {

    cat(
      "Too few proteins for:",
      title,
      "\n"
    )

    return(invisible(NULL))
  }


  # Limit to 50 proteins ranked by minimum FDR
  if (length(proteins) > 50) {

    min_fdr <- sapply(
      proteins,
      function(protein) {

        min(
          sapply(
            results_list,
            function(results) {

              if (
                protein %in%
                rownames(results)
              ) {

                results[
                  protein,
                  "adj.P.Val"
                ]

              } else {

                1
              }
            }
          )
        )
      }
    )

    proteins <- names(
      sort(min_fdr)
    )[1:50]

    cat(
      "Limiting to top 50 proteins\n"
    )
  }


  # Expression matrix
  hm <- expr_mat[
    proteins,
    ,
    drop = FALSE
  ]


  # Row z-score
  hm_z <- t(
    scale(
      t(hm)
    )
  )

  hm_z <- pmin(
    pmax(hm_z, -2),
    2
  )


  # Order samples by condition
  col_order <- order(
    samples_df$Condition
  )


  col_ann <- data.frame(
    Condition = samples_df$Condition[col_order],
    Donor = samples_df$Donor[col_order],
    row.names = samples_df$Sample_code[col_order]
  )


  # Determine which contrasts each protein is significant in
  row_ann <- as.data.frame(
    sapply(
      results_list,
      function(results) {

        significant <- rownames(
          results[
            results$Direction !=
              "Not significant",
          ,
            drop = FALSE
          ]
        )

        ifelse(
          proteins %in% significant,
          "Yes",
          "No"
        )
      }
    ),
    stringsAsFactors = FALSE
  )

  colnames(row_ann) <- contrast_names
  rownames(row_ann) <- proteins


  # Donor colours
  donor_levels <- levels(
    samples_df$Donor
  )

  donor_colours <- setNames(
    brewer.pal(
      max(3, length(donor_levels)),
      "Set2"
    )[seq_along(donor_levels)],
    donor_levels
  )


  annotation_colours <- list(
    Condition = colours,
    Donor = donor_colours
  )


  for (contrast in contrast_names) {

    annotation_colours[[contrast]] <- c(
      Yes = "#E53935",
      No = "grey90"
    )
  }


  ph <- pheatmap(
    hm_z[, col_order],
    annotation_col = col_ann,
    annotation_row = row_ann,
    annotation_colors = annotation_colours,
    cluster_cols = FALSE,
    cluster_rows = TRUE,
    show_rownames = TRUE,
    show_colnames = FALSE,
    fontsize_row = 6,
    fontsize = 9,
    color = colorRampPalette(
      c(
        "#2166AC",
        "white",
        "#B2182B"
      )
    )(100),
    breaks = seq(
      -2,
      2,
      length.out = 101
    ),
    border_color = NA,
    main = title,
    silent = TRUE
  )


  print(ph)

  pdf(
    filename,
    width = 12,
    height = max(
      7,
      length(proteins) * 0.22
    )
  )

  print(ph)
  dev.off()

  cat(
    "Saved:",
    filename,
    "\n"
  )
}

