# 2. IMPORT DATA

samples_ipf <- read_excel(
  "IPF_Donors_SampleandProteinList_CM.xlsx",
  sheet = "SampleList"
) %>%
  filter(
    !is.na(MS_code),
    trimws(MS_code) != ""
  )

proteins_ipf <- read_excel(
  "IPF_Donors_SampleandProteinList_CM.xlsx",
  sheet = "ProteinList"
)

# 3. FILTER SAMPLES

samples_f <- samples_ipf %>%
  filter(
    Condition %in% c(
      "day0_SF",
      "day7_DMSO",
      "day7_Nin",
      "day7_Senic"
    )
  ) %>%
  mutate(
    Condition = factor(
      Condition,
      levels = c(
        "day0_SF",
        "day7_DMSO",
        "day7_Nin",
        "day7_Senic"
      )
    ),
    Donor = factor(Donor)
  )

cat("=== SAMPLE INFORMATION ===\n")
cat("Samples retained:", nrow(samples_f), "\n\n")

cat("Design balance:\n")
print(table(samples_f$Condition, samples_f$Donor))



# 4. COLOUR SCHEMES - for plots 

condition_colours <- c(
  day0_SF = "#2196F3",
  day7_DMSO = "#E53935",
  day7_Nin = "#4CAF50",
  day7_Senic = "#FF9800"
)

day7_colours <- c(
  day7_DMSO = "#E53935",
  day7_Nin = "#4CAF50",
  day7_Senic = "#FF9800"
)


# 5. EXPRESSION MATRIX

sample_codes <- samples_f$Sample_code

expr <- proteins_ipf %>%
  select(all_of(sample_codes)) %>%
  mutate(
    across(
      everything(),
      ~ as.numeric(as.character(.))
    )
  ) %>%
  as.data.frame()

rownames(expr) <- make.unique(
  as.character(proteins_ipf$PG.Genes)
)

stopifnot(
  all(colnames(expr) == samples_f$Sample_code)
)

cat(
  "\nExpression matrix:",
  nrow(expr),
  "proteins x",
  ncol(expr),
  "samples\n"
)

#######################################################
#STEP 1 - RAW DATA PREPROCESSING 

# 6. COMPLETENESS FILTER — 70%

min_values <- ceiling(
  0.70 * ncol(expr)
)

expr_c <- expr[
  apply(
    expr,
    1,
    function(x) {
      sum(!is.na(x) & x > 0) >= min_values
    }
  ),
  ,
  drop = FALSE
]

cat(
  "After completeness filtering:",
  nrow(expr_c),
  "proteins\n"
)


# 7. IMPUTATION & LOG2 TRANSFORMATION

expr_i <- expr_c

expr_i[expr_i == 0] <- NA

for (j in seq_len(ncol(expr_i))) {

  column_min <- min(
    expr_i[, j],
    na.rm = TRUE
  )

  if (!is.finite(column_min)) {
    column_min <- 1
  }

  expr_i[is.na(expr_i[, j]), j] <- column_min / 5
}

expr_l <- log2(
  as.matrix(expr_i)
)


# 8. MEDIAN NORMALISATION

global_median <- median(expr_l)

sample_medians <- apply(
  expr_l,
  2,
  median
)

expr_n <- sweep(
  expr_l,
  2,
  global_median - sample_medians,
  "+"
)


# 9. ABUNDANCE & VARIABILITY FILTERING

# Abundance filter
expr_a <- expr_n[
  rowMeans(expr_n) >
    quantile(rowMeans(expr_n), 0.40),
  ,
  drop = FALSE
]

# MAD filter
median_absolute_deviation <- rowMads(expr_a)

expr_v <- expr_a[
  median_absolute_deviation >
    median(median_absolute_deviation),
  ,
  drop = FALSE
]

# Near-zero variance filter
nzv <- nearZeroVar(
  t(expr_v)
)

if (length(nzv) > 0) {
  expr_v <- expr_v[
    -nzv,
    ,
    drop = FALSE
  ]
}

cat(
  "After filtering:",
  nrow(expr_v),
  "proteins\n"
)


# 10. ARSYNSEQ DENOISING

factors_df <- data.frame(
  Condition = samples_f$Condition,
  Donor = samples_f$Donor,
  row.names = samples_f$Sample_code
)

nd <- readData(
  data = as.data.frame(expr_v),
  factors = factors_df
)

den_obj <- ARSyNseq(
  nd,
  factor = "Donor",
  batch = TRUE,
  norm = "n",
  logtransf = TRUE
)

expr_final <- as.matrix(
  exprs(den_obj)
)

expr_final <- expr_final[
  ,
  samples_f$Sample_code,
  drop = FALSE
]

cat(
  "Final matrix:",
  nrow(expr_final),
  "proteins x",
  ncol(expr_final),
  "samples\n\n"
)

##############################################################
#STEP 2 DIFFERERNTIAL EXPRESSION ANALYSIS 

# 11. LIMMA MODEL

design <- model.matrix(
  ~ 0 + Condition,
  data = samples_f
)

colnames(design) <- levels(
  samples_f$Condition
)

fit <- lmFit(
  expr_final,
  design
)


# 12. CONTRASTS - individually make contrasts
#clearly define contrasts using makeContrasts func so that individual expression is estimated
  # not grouped exp!!
contrasts <- makeContrasts(

  # Disease/time effect:
  # day 7 IPF tissue compared with day 0 control
  Baseline = day7_DMSO - day0_SF,

  # Drug effects:
  Nintedanib = day7_Nin - day7_DMSO,
  Senicapoc = day7_Senic - day7_DMSO,

  levels = design
)


fit2 <- contrasts.fit(
  fit,
  contrasts
)

fit2 <- eBayes(
  fit2,
  trend = TRUE
)

# 13. RESULT EXTRACTION FUNCTION

extract_results <- function(
    fit_object,
    contrast_name,
    up_label,
    down_label
) {

  results <- topTable(
    fit_object,
    coef = contrast_name,
    number = Inf,
    sort.by = "P"
  ) %>%
    mutate(

      negLogP = -log10(P.Value),

      Direction = case_when(
        adj.P.Val < 0.1 &
          logFC > 0.58 ~ up_label,

        adj.P.Val < 0.1 &
          logFC < -0.58 ~ down_label,

        TRUE ~ "Not significant"
      ),

      Contrast = contrast_name
    )


  cat("\n========================================\n")
  cat(contrast_name, "\n")
  cat("========================================\n")

  cat(
    "Proteins tested:",
    nrow(results),
    "\n"
  )

  cat(
    "Raw p < 0.05:",
    sum(results$P.Value < 0.05),
    "\n"
  )

  cat(
    "FDR < 0.1:",
    sum(results$adj.P.Val < 0.1),
    "\n"
  )

  cat(
    "FDR < 0.1 & |logFC| > 0.58:",
    sum(
      results$adj.P.Val < 0.1 &
        abs(results$logFC) > 0.58
    ),
    "\n"
  )

  cat(
    "Up:",
    sum(results$Direction == up_label),
    "\n"
  )

  cat(
    "Down:",
    sum(results$Direction == down_label),
    "\n"
  )

  return(results)
}


# 14. RUN ALL THREE CONTRASTS - simultaneously done!!

