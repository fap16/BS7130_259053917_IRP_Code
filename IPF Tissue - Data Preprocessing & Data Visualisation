# 17. VOLCANO PLOT 

make_volcano <- function(
    results,
    title,
    up_colour,
    down_colour,
    filename
) {

  fdr_line <- if (
    any(results$adj.P.Val < 0.1)
  ) {

    -log10(
      max(
        results$P.Value[
          results$adj.P.Val < 0.1
        ]
      )
    )

  } else {

    -log10(0.05)
  }


  # Label top 15 nominally significant proteins
  top_labels <- results %>%
    filter(
      Direction != "Not significant"
    ) %>%
    arrange(P.Value) %>%
    slice_head(n = 15) %>%
    rownames()


  results <- results %>%
    mutate(
      Label = ifelse(
        rownames(.) %in% top_labels,
        rownames(.),
        NA
      )
    )


  direction_levels <- unique(
    results$Direction[
      results$Direction != "Not significant"
    ]
  )

  colour_values <- setNames(
    c(
      up_colour,
      down_colour,
      "grey70"
    ),
    c(
      direction_levels,
      "Not significant"
    )
  )


  p <- ggplot(
    results,
    aes(
      logFC,
      negLogP,
      colour = Direction
    )
  ) +

    geom_point(
      alpha = 0.6,
      size = 1.8
    ) +

    geom_hline(
      yintercept = fdr_line,
      linetype = "dashed",
      colour = "grey30",
      linewidth = 0.7
    ) +

    geom_hline(
      yintercept = -log10(0.05),
      linetype = "dotted",
      colour = "steelblue",
      linewidth = 0.7
    ) +

    geom_vline(
      xintercept = c(
        -0.58,
        0.58
      ),
      linetype = "dashed",
      colour = "grey30",
      linewidth = 0.7
    ) +

    scale_colour_manual(
      values = colour_values
    ) +

    geom_text_repel(
      aes(label = Label),
      size = 2.8,
      max.overlaps = 20,
      box.padding = 0.4,
      colour = "black",
      show.legend = FALSE
    ) +

    annotate(
      "text",
      x = Inf,
      y = fdr_line + 0.1,
      label = "FDR = 0.1",
      hjust = 1.1,
      size = 3.2,
      colour = "grey30"
    ) +

    theme_classic(
      base_size = 13
    ) +

    labs(
      title = title,
      subtitle = "FDR < 0.1 & |log2FC| > 0.58 coloured",
      x = expression(log[2] ~ "FC"),
      y = expression(-log[10] ~ "(p)"),
      colour = NULL
    ) +

    theme(
      legend.position = "bottom"
    )


  print(p)

  ggsave(
    filename,
    p,
    width = 7.5,
    height = 6.5
  )
}


